BACKEND_URL=http://localhost:4000
SOROBAN_RPC_URL=https://soroban-testnet.stellar.org
HORIZON_URL=https://horizon-testnet.stellar.org
NETWORK_PASSPHRASE=Test SDF Network ; September 2015
ORACLE_CONTRACT_ID=

# Funded testnet key standing in for a browser wallet (ask.js can't use a
# browser extension headlessly, so it signs directly with this secret).
DEMO_PAYER_SECRET=

# Optional — defaults to "standard" / no category.
TIER=standard
CATEGORY=

# Used only by worker-sim.js.
WORKER_ID=demo-worker-1
WORKER_ANSWER=42
WORKER_CATEGORIES=
# Optional: a funded testnet secret. Setting this makes worker-sim.js use a
# real signable Stellar address as its workerId (instead of an arbitrary
# string) and unlocks the staking/auto-withdraw demo below.
WORKER_SECRET=
DO_STAKE=false
STAKE_AMOUNT_STROOPS=1000000
AUTO_WITHDRAW=false
WITHDRAW_INTERVAL_MS=30000

# Used only by sponsored-demo.js — a separately-funded USDC holder that pays
# its own network fee to seed a fresh, still-XLM-less keypair with test USDC.
FUNDING_PAYER_SECRET=
